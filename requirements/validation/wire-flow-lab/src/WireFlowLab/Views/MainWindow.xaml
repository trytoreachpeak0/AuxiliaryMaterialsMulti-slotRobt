<Window x:Class="WireFlowLab.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WireFlowLab.ViewModels"
        Title="焊丝发放流程验证工具 — WireFlowLab" Height="820" Width="1380"
        FontFamily="Microsoft YaHei UI" FontSize="13" Background="#F4F6F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style x:Key="TraceRowStyle" TargetType="ListViewItem">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Error">
                    <Setter Property="Background" Value="#FFEBEE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter Property="Background" Value="#FFF8E1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="230"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="8" BorderBrush="#D0D7DE" BorderThickness="1">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="流程:" VerticalAlignment="Center" Margin="4,0"/>
                <ComboBox Width="320" ItemsSource="{Binding Flows}" SelectedItem="{Binding SelectedFlow}"
                          DisplayMemberPath="Title" Margin="4,0"/>
                <Button Content="开始" Command="{Binding StartFlowCommand}" Background="#1976D2" Foreground="White"/>
                <Button Content="单步 ▶" Command="{Binding StepCommand}"/>
                <Button Content="连续执行 ⏩" Command="{Binding RunToEndCommand}"/>
                <Separator/>
                <Button Content="重置数据库" Command="{Binding ResetDbCommand}"/>
                <Button Content="校验全部流程" Command="{Binding ValidateAllCommand}"/>
                <Button Content="无界面自测" Command="{Binding RunSelfTestCommand}"/>
                <Button Content="导出 findings" Command="{Binding ExportFindingsCommand}"/>
            </WrapPanel>
        </Border>

        <!-- 主体三栏 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：执行轨迹 -->
            <GroupBox Grid.Column="0" Header="执行轨迹 Trace">
                <ListView ItemsSource="{Binding Trace}" ItemContainerStyle="{StaticResource TraceRowStyle}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="#" Width="34" DisplayMemberBinding="{Binding Step}"/>
                            <GridViewColumn Header="节点" Width="180" DisplayMemberBinding="{Binding NodeId}"/>
                            <GridViewColumn Header="类型" Width="100" DisplayMemberBinding="{Binding NodeType}"/>
                            <GridViewColumn Header="结果key" Width="70" DisplayMemberBinding="{Binding Outcome}"/>
                            <GridViewColumn Header="下一步" Width="150" DisplayMemberBinding="{Binding NextNode}"/>
                            <GridViewColumn Header="SQL" Width="240" DisplayMemberBinding="{Binding RenderedSql}"/>
                            <GridViewColumn Header="结果" Width="320" DisplayMemberBinding="{Binding Result}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>

            <!-- 中：当前节点 + 输入 -->
            <GroupBox Grid.Column="1" Header="当前节点 / 输入">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="当前节点" FontWeight="Bold" Margin="2,4"/>
                        <Border Background="White" CornerRadius="4" Padding="8" Margin="2" BorderBrush="#D0D7DE" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentNodeId}" FontWeight="Bold" FontSize="15" Foreground="#1976D2"/>
                                <TextBlock Text="{Binding CurrentNodeText}" TextWrapping="Wrap" Margin="0,4"/>
                                <TextBlock Text="{Binding CurrentNodeType}" Foreground="Gray"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding AwaitingInput, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="请输入" FontWeight="Bold" Margin="2,10,2,4"/>
                            <ItemsControl ItemsSource="{Binding CurrentInputs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="填好后点上方「单步 ▶」推进。" Foreground="Gray" Margin="2,6" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <!-- 右：MES 设置 + 格口面板 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="MES 设置">
                    <StackPanel>
                        <TextBlock Text="{Binding MesModeText}" FontWeight="Bold" Foreground="#1976D2" Margin="2"/>
                        <CheckBox Content="使用真实 Oracle MES（取消勾选=SQLite mock）" IsChecked="{Binding UseOracle}" Margin="2,4"/>
                        <TextBlock Text="Oracle 连接串:" Margin="2,4,2,0"/>
                        <TextBox Text="{Binding OracleConnString}" Margin="2"/>
                        <Separator Margin="2,6"/>
                        <TextBlock Text="SQLite mock — 存储函数结果:" FontWeight="Bold" Margin="2,4"/>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="配额差值 (米，任意数值=通过):"/>
                                <TextBox Text="{Binding QuotaDiff}"/>
                                <TextBlock Text="配额错误 (模拟 ORA-20007，留空=成功):" Margin="0,4,0,0"/>
                                <TextBox Text="{Binding QuotaError}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="提交结果 (SUCCESS / ERROR:...):"/>
                                <TextBox Text="{Binding SubmitResult}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="2,4">
                            <TextBlock Text="系统 AGV 编号:" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding AgvNo}" Width="120" Margin="6,0"/>
                            <Button Content="应用 MES 设置" Command="{Binding ApplyMesCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="格口仓库（mock 仓门）">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Slots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="150" Margin="4" CornerRadius="6" BorderBrush="#90A4AE" BorderThickness="1"
                                            Background="{Binding DoorBrush}">
                                        <StackPanel Margin="6">
                                            <TextBlock Text="{Binding SlotNo}" FontWeight="Bold" FontSize="15"/>
                                            <Border CornerRadius="3" Padding="2" Margin="0,2" Background="{Binding BizBrush}">
                                                <TextBlock Text="{Binding BizState}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding DoorText}"/>
                                            <TextBlock Text="{Binding LockText}"/>
                                            <TextBlock Text="{Binding WireText}" TextWrapping="Wrap" FontSize="11" Foreground="#37474F"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                <Button Content="开门" Padding="6,2"
                                                        Command="{Binding DataContext.OpenDoorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="关门" Padding="6,2"
                                                        Command="{Binding DataContext.CloseDoorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- 验证结论 -->
        <GroupBox Grid.Row="2" Header="验证结论 Findings">
            <ListView ItemsSource="{Binding Findings}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="级别" Width="80" DisplayMemberBinding="{Binding Severity}"/>
                        <GridViewColumn Header="流程" Width="280" DisplayMemberBinding="{Binding FlowId}"/>
                        <GridViewColumn Header="节点" Width="200" DisplayMemberBinding="{Binding NodeId}"/>
                        <GridViewColumn Header="类别" Width="100" DisplayMemberBinding="{Binding Category}"/>
                        <GridViewColumn Header="说明" Width="640" DisplayMemberBinding="{Binding Message}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="#263238" CornerRadius="4" Margin="6,2" Padding="8,4">
            <TextBlock Text="{Binding StatusText}" Foreground="White"/>
        </Border>
    </Grid>
</Window>
