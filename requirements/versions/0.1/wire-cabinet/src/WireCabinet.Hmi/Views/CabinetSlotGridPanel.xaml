<UserControl x:Class="WireCabinet.Hmi.Views.CabinetSlotGridPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <UserControl.Resources>
        <Style x:Key="SlotNoText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>
        <Style x:Key="SlotTypeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="SlotStatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
        <Style x:Key="SummaryCountLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style x:Key="SummaryCountValue" TargetType="TextBlock" BasedOn="{StaticResource ValueText}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="LegendSwatch" TargetType="Border">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardPanel}" Padding="12,10"
            PreviewMouseLeftButtonDown="PanelRootGrid_PreviewMouseLeftButtonDown">
        <Grid x:Name="PanelRootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Grid.Column="0" Text="发货柜格口状态"
                           Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel x:Name="SummaryPanel" Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="总数" Style="{StaticResource SummaryCountLabel}"/>
                    <TextBlock x:Name="TotalCountText" Text="—" Style="{StaticResource SummaryCountValue}"/>
                    <TextBlock x:Name="Count2Label" Text="空闲" Style="{StaticResource SummaryCountLabel}"/>
                    <TextBlock x:Name="Count2Text" Text="—" Style="{StaticResource SummaryCountValue}"/>
                    <TextBlock x:Name="Count3Label" Text="有料" Style="{StaticResource SummaryCountLabel}"/>
                    <TextBlock x:Name="Count3Text" Text="—" Style="{StaticResource SummaryCountValue}"
                               Foreground="{StaticResource SuccessBrush}"/>
                    <TextBlock x:Name="Count4Label" Text="退回" Style="{StaticResource SummaryCountLabel}"/>
                    <TextBlock x:Name="Count4Text" Text="—" Style="{StaticResource SummaryCountValue}"
                               Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnFrontSide" Content="前柜" Style="{StaticResource PrimaryButton}"
                            Padding="12,6" MinHeight="0" Height="36" Margin="0,0,6,0" Click="BtnFrontSide_Click"/>
                    <Button x:Name="BtnRearSide" Content="后柜" Style="{StaticResource SecondaryButton}"
                            Padding="12,6" MinHeight="0" Height="36" Margin="0,0,10,0" Click="BtnRearSide_Click"/>
                    <TextBlock x:Name="LastRefreshText" Text="刷新时间：—" Style="{StaticResource LabelText}"/>
                </StackPanel>
            </Grid>

            <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource DividerBrush}" Margin="0,0,0,8"/>

            <Grid x:Name="SlotGridArea" Grid.Row="2" Background="Transparent">
                <Viewbox x:Name="SlotViewbox" Stretch="Uniform">
                    <UniformGrid x:Name="SlotGridHost" Columns="3" Rows="9" Width="480" Height="630"/>
                </Viewbox>
                <Border x:Name="LegendPanelMh" Background="#E6FFFFFF" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" Padding="8,6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,4,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,4">
                            <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource SlotEmptyBrush}"/>
                            <TextBlock Text="空闲" Style="{StaticResource LabelText}" FontSize="12" Margin="4,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Style="{StaticResource LegendSwatch}"
                                    Background="{StaticResource SlotLoadedBrush}"
                                    BorderBrush="{StaticResource SlotLoadedBorderBrush}"/>
                            <TextBlock Text="有料" Style="{StaticResource LabelText}" FontSize="12" Margin="4,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,4">
                            <Border Style="{StaticResource LegendSwatch}"
                                    Background="{StaticResource SlotReturnedBrush}"
                                    BorderBrush="{StaticResource SlotReturnedBorderBrush}"/>
                            <TextBlock Text="退回" Style="{StaticResource LabelText}" FontSize="12" Margin="4,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Style="{StaticResource LegendSwatch}"
                                    Background="{StaticResource SlotOpenBrush}"
                                    BorderBrush="{StaticResource SlotOpenBorderBrush}"/>
                            <TextBlock Text="已打开" Style="{StaticResource LabelText}" FontSize="12" Margin="4,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                            <Border Style="{StaticResource LegendSwatch}"
                                    Background="{StaticResource SlotDisabledBrush}"
                                    BorderBrush="{StaticResource SlotDisabledBorderBrush}"/>
                            <TextBlock Text="已禁用" Style="{StaticResource LabelText}" FontSize="12" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="LegendPanelMaint" Background="#E6FFFFFF" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" Padding="8,6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,4,4" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,4">
                            <Border Style="{StaticResource LegendSwatch}"
                                    Background="{StaticResource SlotLoadedBrush}"
                                    BorderBrush="{StaticResource SlotLoadedBorderBrush}"/>
                            <TextBlock Text="启用·门关" Style="{StaticResource LabelText}" FontSize="12" Margin="4,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Style="{StaticResource LegendSwatch}"
                                    Background="{StaticResource SlotOpenBrush}"
                                    BorderBrush="{StaticResource SlotOpenBorderBrush}"
                                    BorderThickness="2"/>
                            <TextBlock Text="启用·门开" Style="{StaticResource LabelText}" FontSize="12" Margin="4,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                            <Border Style="{StaticResource LegendSwatch}"
                                    Background="{StaticResource SlotDisabledBrush}"
                                    BorderBrush="{StaticResource SlotDisabledBorderBrush}"/>
                            <TextBlock Text="禁用·门关" Style="{StaticResource LabelText}" FontSize="12" Margin="4,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <Border Style="{StaticResource LegendSwatch}"
                                    Background="{StaticResource SlotDisabledBrush}"
                                    BorderBrush="{StaticResource SlotOpenBorderBrush}"
                                    BorderThickness="2"/>
                            <TextBlock Text="禁用·门开" Style="{StaticResource LabelText}" FontSize="12" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
