<UserControl x:Class="WireCabinet.Hmi.Views.CabinetSlotGridPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <UserControl.Resources>
        <Style x:Key="SlotNoText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>
        <Style x:Key="SlotTypeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="SlotStatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardPanel}" Padding="12,10"
            PreviewMouseLeftButtonDown="PanelRootGrid_PreviewMouseLeftButtonDown">
        <Grid x:Name="PanelRootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Grid.Column="0" Text="发货柜格口状态"
                           Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnFrontSide" Content="前柜" Style="{StaticResource PrimaryButton}"
                            Padding="12,6" MinHeight="0" Height="36" Margin="0,0,6,0" Click="BtnFrontSide_Click"/>
                    <Button x:Name="BtnRearSide" Content="后柜" Style="{StaticResource SecondaryButton}"
                            Padding="12,6" MinHeight="0" Height="36" Margin="0,0,10,0" Click="BtnRearSide_Click"/>
                    <TextBlock x:Name="LastRefreshText" Text="刷新时间：—" Style="{StaticResource LabelText}"/>
                </StackPanel>
            </Grid>

            <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource DividerBrush}" Margin="0,0,0,8"/>

            <Grid x:Name="SlotGridArea" Grid.Row="2" Background="Transparent">
                <Viewbox x:Name="SlotViewbox" Stretch="Uniform">
                    <UniformGrid x:Name="SlotGridHost" Columns="3" Rows="9" Width="360" Height="630"/>
                </Viewbox>
            </Grid>
        </Grid>
    </Border>
</UserControl>
