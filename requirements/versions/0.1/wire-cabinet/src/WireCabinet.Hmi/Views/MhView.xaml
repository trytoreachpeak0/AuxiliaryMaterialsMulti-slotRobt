<UserControl x:Class="WireCabinet.Hmi.Views.MhView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WireCabinet.Hmi.Views"
             FontFamily="{StaticResource UiFont}">

    <UserControl.Resources>
        <Style x:Key="TightCard" TargetType="Border" BasedOn="{StaticResource CardPanel}">
            <Setter Property="Padding" Value="12,10"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource TightCard}">
                <StackPanel>
                    <TextBlock Text="存放焊丝" Style="{StaticResource SectionTitle}"/>
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,0,0,10"/>

                    <TextBlock Text="焊丝批号（扫码 / 手动输入）" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WireLotBox" Grid.Column="0" Style="{StaticResource IndustrialTextBox}"
                                 TextChanged="WireLotBox_TextChanged" KeyDown="WireLotBox_KeyDown"/>
                        <Button x:Name="ClearLotBtn" Grid.Column="1" Content="清空"
                                Style="{StaticResource SecondaryButton}" MinWidth="72" Margin="8,0,0,0"
                                Click="ClearLotBtn_Click"/>
                    </Grid>

                    <TextBlock x:Name="WireErrorText" Text="焊丝批号不存在" Style="{StaticResource ValueText}"
                               Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0"
                               Visibility="Collapsed"/>

                    <Border x:Name="WireInfoPanel" Background="#FFF1F7FF" BorderBrush="#FFB8D6FB" BorderThickness="1"
                            Padding="10,6" Margin="0,8,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="类型：" Style="{StaticResource LabelText}" Width="58"/>
                                <TextBlock x:Name="WireTypeText" Text="" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="分配：" Style="{StaticResource LabelText}" Width="58"/>
                                <TextBlock x:Name="AllocText" Text="" Style="{StaticResource ValueText}"
                                           Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button x:Name="DepositActionBtn" Content="输入焊丝" Style="{StaticResource PrimaryButton}"
                            Margin="0,10,0,0" Height="46" FontSize="15" Click="DepositActionBtn_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource TightCard}">
                <StackPanel>
                    <TextBlock Text="格口批量控制" Style="{StaticResource SectionTitle}"/>
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,0,0,10"/>

                    <Button x:Name="BtnOpenAvailable" Content="打开可用焊丝格口" Style="{StaticResource PrimaryButton}"
                            Height="46" Margin="0,0,0,6" Click="BtnOpenAvailable_Click"/>
                    <Button x:Name="BtnOpenReturned" Content="打开所有归还焊丝格口" Style="{StaticResource WarningButton}"
                            Height="46" Margin="0,0,0,6" Click="BtnOpenReturned_Click"/>
                    <Button x:Name="BtnOpenAll" Content="打开所有非禁用和有料格口" Style="{StaticResource SecondaryButton}"
                            Height="46" Click="BtnOpenAll_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource TightCard}">
                <StackPanel>
                    <TextBlock Text="格口信息" Style="{StaticResource SectionTitle}"/>
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,0,0,8"/>

                    <TextBlock x:Name="SlotInfoHintText" Text="点击格口可显示焊丝信息"
                               Style="{StaticResource LabelText}" TextWrapping="Wrap"/>

                    <StackPanel x:Name="SlotInfoPanel" Visibility="Collapsed" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="格口编号" Style="{StaticResource LabelText}" Width="72"/>
                            <TextBlock x:Name="SlotInfoNoText" Style="{StaticResource ValueText}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="焊丝批号" Style="{StaticResource LabelText}" Width="72"/>
                            <TextBlock x:Name="SlotInfoLotText" Style="{StaticResource ValueText}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="焊丝规格" Style="{StaticResource LabelText}" Width="72"/>
                            <TextBlock x:Name="SlotInfoSpecText" Style="{StaticResource ValueText}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="焊丝状态" Style="{StaticResource LabelText}" Width="72"/>
                            <TextBlock x:Name="SlotInfoStatusText" Style="{StaticResource ValueText}"/>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="BtnOpenSelected" Content="打开此格口" Style="{StaticResource PrimaryButton}"
                            Height="46" Margin="0,8,0,0" Visibility="Collapsed" Click="BtnOpenSelected_Click"/>
                </StackPanel>
            </Border>
        </Grid>
        </ScrollViewer>

        <views:CabinetSlotGridPanel x:Name="SlotGrid" Grid.Column="2" PanelTitle="发货柜格口状态"
                                    EnableClearSelection="True"/>
    </Grid>
</UserControl>
