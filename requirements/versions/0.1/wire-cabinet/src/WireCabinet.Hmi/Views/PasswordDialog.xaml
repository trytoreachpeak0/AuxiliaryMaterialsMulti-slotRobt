<Window x:Class="WireCabinet.Hmi.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="身份验证"
        Width="380"
        SizeToContent="Height"
        MinHeight="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}"
        Background="{StaticResource WindowBgBrush}">
    <Border Padding="20,18" Background="{StaticResource PanelBgBrush}" Margin="16">
        <StackPanel>
            <TextBlock x:Name="PromptText" Text="请输入密码" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
            <PasswordBox x:Name="PasswordBox" Height="40" FontSize="16" Margin="0,0,0,10"
                         KeyDown="PasswordBox_KeyDown"/>
            <TextBlock x:Name="ErrorText" Foreground="#FFE74C3C" FontSize="13"
                       Visibility="Collapsed" Margin="0,0,0,10" MinHeight="18"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button Content="取消" Style="{StaticResource SecondaryButton}" Width="96"
                        Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/>
                <Button Content="确定" Style="{StaticResource PrimaryButton}" Width="96"
                        IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
