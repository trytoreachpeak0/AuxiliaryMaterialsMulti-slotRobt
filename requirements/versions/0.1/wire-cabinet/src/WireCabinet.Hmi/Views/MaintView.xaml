<UserControl x:Class="WireCabinet.Hmi.Views.MaintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WireCabinet.Hmi.Views"
             FontFamily="{StaticResource UiFont}">

    <UserControl.Resources>
        <Style x:Key="TightCard" TargetType="Border" BasedOn="{StaticResource CardPanel}">
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style x:Key="MaintDataLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="MaintDataValue" TargetType="TextBlock" BasedOn="{StaticResource ValueText}">
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource TightCard}">
                <StackPanel>
                    <TextBlock Text="连接状态" Style="{StaticResource SectionTitle}"/>
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="格口硬件" Style="{StaticResource MaintDataLabel}" Width="72"/>
                        <TextBlock x:Name="HwConfiguredText" Text="—" Style="{StaticResource MaintDataValue}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Text="IO 模块" Style="{StaticResource MaintDataLabel}" Margin="0,0,0,4"/>
                    <StackPanel x:Name="IoModuleListPanel"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource TightCard}">
                <StackPanel>
                    <TextBlock Text="选中格口" Style="{StaticResource SectionTitle}"/>
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,0,0,10"/>

                    <TextBlock x:Name="DetailHintText" Text="点击右侧格口查看锁 DI / IO 点位"
                               Style="{StaticResource MaintDataLabel}" TextWrapping="Wrap"/>

                    <StackPanel x:Name="DetailPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="编号" Style="{StaticResource MaintDataLabel}" Width="72"/>
                            <TextBlock x:Name="DetailSlotNoText" Style="{StaticResource MaintDataValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="位置" Style="{StaticResource MaintDataLabel}" Width="72"/>
                            <TextBlock x:Name="DetailPositionText" Style="{StaticResource MaintDataValue}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="模块 MAC" Style="{StaticResource MaintDataLabel}" Width="72"/>
                            <TextBlock x:Name="DetailModuleText" Style="{StaticResource MaintDataValue}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="IO 点位" Style="{StaticResource MaintDataLabel}" Width="72"/>
                            <TextBlock x:Name="DetailIoText" Style="{StaticResource MaintDataValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="锁反馈" Style="{StaticResource MaintDataLabel}" Width="72"/>
                            <TextBlock x:Name="DetailLockText" Style="{StaticResource MaintDataValue}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="启用状态" Style="{StaticResource MaintDataLabel}" Width="72"/>
                            <TextBlock x:Name="DetailEnabledText" Style="{StaticResource MaintDataValue}"/>
                        </StackPanel>
                        <TextBlock Text="本柜无门磁，门态由锁反馈 DI 推断。"
                                   Style="{StaticResource MaintDataLabel}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock x:Name="DetailReadTimeText" Style="{StaticResource MaintDataLabel}" Margin="0,0,0,8"/>
                        <Grid x:Name="DetailActionPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnTrialOpen" Grid.Column="0" Content="试开此格"
                                    Style="{StaticResource PrimaryButton}" Height="46"
                                    Click="BtnTrialOpen_Click"/>
                            <Button x:Name="BtnToggleDisable" Grid.Column="2" Content="禁用此格"
                                    Style="{StaticResource SecondaryButton}" Height="46"
                                    Click="BtnToggleDisable_Click"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource TightCard}">
                <StackPanel>
                    <TextBlock Text="批量操作" Style="{StaticResource SectionTitle}"/>
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,0,0,10"/>

                    <Button x:Name="BtnOpenAllMaint" Content="打开所有格口" Style="{StaticResource SecondaryButton}"
                            Height="46" Margin="0,0,0,8" Click="BtnOpenAllMaint_Click"/>
                    <Button x:Name="BtnOpenFrontMaint" Content="打开前柜所有格口" Style="{StaticResource SecondaryButton}"
                            Height="46" Margin="0,0,0,8" Click="BtnOpenFrontMaint_Click"/>
                    <Button x:Name="BtnOpenRearMaint" Content="打开后柜所有格口" Style="{StaticResource SecondaryButton}"
                            Height="46" Click="BtnOpenRearMaint_Click"/>
                </StackPanel>
            </Border>
        </Grid>
        </ScrollViewer>

        <views:CabinetSlotGridPanel x:Name="SlotGrid" Grid.Column="2" PanelTitle="格口传感器状态"
                                    EnableClearSelection="True" LegendMode="Maint"/>
    </Grid>
</UserControl>
