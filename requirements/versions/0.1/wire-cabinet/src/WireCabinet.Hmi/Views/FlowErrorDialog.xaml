<Window x:Class="WireCabinet.Hmi.Views.FlowErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="操作失败"
        Width="420"
        SizeToContent="Height"
        MinHeight="180"
        MaxHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}"
        Background="{StaticResource WindowBgBrush}">
    <Border Padding="20,18" Background="{StaticResource PanelBgBrush}" Margin="16">
        <StackPanel>
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       FontSize="16"
                       LineHeight="24"
                       Margin="0,0,0,18"/>
            <Button Content="确认"
                    Style="{StaticResource PrimaryButton}"
                    Width="120"
                    Height="44"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    IsCancel="True"
                    Click="Confirm_Click"/>
        </StackPanel>
    </Border>
</Window>
