<Window x:Class="WireCabinet.Hmi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WireCabinet.Hmi.Views"
        Title="焊丝发放系统 - 演示界面"
        Width="1024" Height="768"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="{StaticResource UiFont}">

    <Window.Resources>
        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFB6C2CF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 + 角色切换 -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBgBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0">
                    <Border Width="6" Height="26" Background="#FF3B9DFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="焊丝发放系统" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="DEMO" FontSize="11" Foreground="#FF8FA3B5"
                               VerticalAlignment="Center" Margin="10,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <RadioButton x:Name="RbOp" Content="操作员 OP" GroupName="Role"
                                 Style="{StaticResource RoleTabButton}"
                                 IsChecked="True"
                                 Checked="RbOp_Checked"/>
                    <RadioButton x:Name="RbMh" Content="物料员 MH" GroupName="Role"
                                 Style="{StaticResource RoleTabButton}"
                                 Checked="RbMh_Checked"/>
                    <RadioButton x:Name="RbMaint" Content="维护 MAINT" GroupName="Role"
                                 Style="{StaticResource RoleTabButton}"
                                 Checked="RbMaint_Checked"/>
                    <RadioButton x:Name="RbMesRecon" Content="MES 对账" GroupName="Role"
                                 Style="{StaticResource RoleTabButton}"
                                 Checked="RbMesRecon_Checked"/>
                    <RadioButton x:Name="RbAgv" Content="控车 AGV" GroupName="Role"
                                 Style="{StaticResource RoleTabButton}"
                                 Checked="RbAgv_Checked"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="—" Style="{StaticResource HeaderIconButton}" Click="MinimizeBtn_Click"/>
                    <Button Content="×" Style="{StaticResource HeaderIconButton}" Click="CloseBtn_Click" FontSize="22"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <ContentControl x:Name="MainContent" Grid.Row="1"/>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="#FFE6E9ED" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左：当前角色 / 操作状态提示 -->
                <TextBlock Grid.Column="0" x:Name="StatusText" Text="就绪" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>

                <!-- 右：IO 模块连接 + 时间 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="IO" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <StackPanel x:Name="IoModulePanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="14" Fill="{StaticResource BorderBrush}" Margin="12,0,12,0"/>
                    <TextBlock x:Name="ClockText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
