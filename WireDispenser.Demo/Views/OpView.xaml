<UserControl x:Class="WireDispenser.Demo.Views.OpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <UserControl.Resources>
        <Style x:Key="StepBadge" TargetType="Border">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style x:Key="StepBadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StepTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 步骤① 操作员身份 -->
        <Border x:Name="Step0Panel" Grid.Row="0" Style="{StaticResource CardPanel}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StepBadge}">
                        <TextBlock Text="1" Style="{StaticResource StepBadgeText}"/>
                    </Border>
                    <TextBlock Text="操作员身份" Style="{StaticResource StepTitleText}"/>
                </StackPanel>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="操作员ID" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="班组" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="6" Text="班次" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="8" Text="姓名（自动）" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>

                <TextBox x:Name="OpIdBox" Grid.Row="1" Grid.Column="2" Style="{StaticResource IndustrialTextBox}"
                         TextChanged="OpField_TextChanged"/>
                <ComboBox x:Name="TeamBox" Grid.Row="1" Grid.Column="4" Style="{StaticResource IndustrialComboBox}"
                          IsEnabled="False">
                    <ComboBoxItem Content="A组" IsSelected="True"/>
                    <ComboBoxItem Content="B组"/>
                    <ComboBoxItem Content="C组"/>
                </ComboBox>
                <ComboBox x:Name="ShiftBox" Grid.Row="1" Grid.Column="6" Style="{StaticResource IndustrialComboBox}"
                          IsEnabled="False">
                    <ComboBoxItem Content="白班" IsSelected="True"/>
                    <ComboBoxItem Content="夜班"/>
                </ComboBox>
                <Border Grid.Row="1" Grid.Column="8" Background="#FFF1F7FF" BorderBrush="#FFB8D6FB" BorderThickness="1"
                        Height="42" Padding="12,0" MinWidth="120">
                    <TextBlock x:Name="OpNameText" Text="—" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
                </Border>
                <Button x:Name="ValidateOpBtn" Grid.Row="1" Grid.Column="10" Content="校验"
                        Style="{StaticResource SecondaryButton}" MinWidth="86" Click="ValidateOpBtn_Click"/>
                <Button x:Name="RestartBtn" Grid.Row="1" Grid.Column="12" Content="重新开始"
                        Style="{StaticResource WarningButton}" MinWidth="100" Click="RestartBtn_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 步骤② 焊丝批号 -->
            <Border x:Name="Step1Panel" Grid.Column="0" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Style="{StaticResource StepBadge}">
                            <TextBlock Text="2" Style="{StaticResource StepBadgeText}"/>
                        </Border>
                        <TextBlock Text="焊丝批号" Style="{StaticResource StepTitleText}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="焊丝批号（扫码 / 手动）" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WireLotBox" Grid.Column="0" Style="{StaticResource IndustrialTextBox}"
                                 IsEnabled="False" TextChanged="WireLotBox_TextChanged"/>
                        <Button x:Name="QueryWireBtn" Grid.Column="1" Content="查询" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" MinWidth="84" IsEnabled="False" Click="QueryWireBtn_Click"/>
                    </Grid>

                    <Border Grid.Row="3" Background="#FFF1F7FF" BorderBrush="#FFB8D6FB" BorderThickness="1"
                            Padding="12,10" Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="焊丝类型：" Style="{StaticResource LabelText}" Width="92"/>
                                <TextBlock x:Name="WireSpecText" Text="—" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="匹配可用焊丝：" Style="{StaticResource LabelText}" Width="92"/>
                                <TextBlock x:Name="MatchedWireText" Text="—" Style="{StaticResource ValueText}"
                                           Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="归还重量：" Style="{StaticResource LabelText}" Width="92"/>
                                <TextBlock x:Name="ReturnedWeightText" Text="—" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 步骤③ 机台信息 -->
            <Border x:Name="Step2Panel" Grid.Column="2" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Style="{StaticResource StepBadge}">
                            <TextBlock Text="3" Style="{StaticResource StepBadgeText}"/>
                        </Border>
                        <TextBlock Text="机台信息" Style="{StaticResource StepTitleText}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="机台号" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="EqpNoBox" Grid.Column="0" Style="{StaticResource IndustrialTextBox}"
                                 IsEnabled="False" TextChanged="EqpNoBox_TextChanged"/>
                        <Button x:Name="ValidateEqpBtn" Grid.Column="1" Content="校验" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" MinWidth="84" IsEnabled="False" Click="ValidateEqpBtn_Click"/>
                    </Grid>

                    <Border Grid.Row="3" Background="#FFF1F7FF" BorderBrush="#FFB8D6FB" BorderThickness="1"
                            Padding="12,10" Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="工单批次号：" Style="{StaticResource LabelText}" Width="98"/>
                                <TextBlock x:Name="ProductLotText" Text="—" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="领用格口：" Style="{StaticResource LabelText}" Width="98"/>
                                <TextBlock x:Name="IssueSlotHintText" Text="—" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="归还格口：" Style="{StaticResource LabelText}" Width="98"/>
                                <TextBlock x:Name="ReturnSlotHintText" Text="—" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 步骤④ 剩余芯片 / 用量校验 -->
        <Border x:Name="Step3Panel" Grid.Row="4" Style="{StaticResource CardPanel}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StepBadge}">
                        <TextBlock Text="4" Style="{StaticResource StepBadgeText}"/>
                    </Border>
                    <TextBlock Text="剩余芯片 / 用量校验" Style="{StaticResource StepTitleText}"/>
                </StackPanel>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="剩余待焊芯片（颗）" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="实际用量差 (米)" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>

                <TextBox x:Name="RemainingQtyBox" Grid.Row="1" Grid.Column="2" Style="{StaticResource IndustrialTextBox}"
                         IsEnabled="False" TextChanged="RemainingQtyBox_TextChanged"/>
                <Border x:Name="QuotaPanel" Grid.Row="1" Grid.Column="4"
                        Background="#FFEEF8F0" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                        Height="42">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="QuotaDeltaText" Text="—" Foreground="{StaticResource SuccessBrush}"
                                   FontWeight="Bold" FontSize="18"/>
                        <TextBlock x:Name="QuotaHintText" Foreground="{StaticResource SuccessBrush}" FontSize="14"
                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button x:Name="ConfirmQuotaBtn" Grid.Row="1" Grid.Column="6" Content="用量校验"
                        Style="{StaticResource SecondaryButton}" MinWidth="96" IsEnabled="False"
                        Click="ConfirmQuotaBtn_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="Step4Panel" Grid.Column="0" Style="{StaticResource CardPanel}" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource StepBadge}">
                            <TextBlock Text="5" Style="{StaticResource StepBadgeText}"/>
                        </Border>
                        <TextBlock Text="存入归还焊丝" Style="{StaticResource StepTitleText}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="归还格口：" Style="{StaticResource LabelText}" Width="74"/>
                            <TextBlock x:Name="ReturnSlotText" Text="—" Style="{StaticResource ValueText}"/>
                        </StackPanel>
                        <TextBlock Text="发货柜将打开归还格口，请放入归还焊丝并关闭格口门。" Style="{StaticResource HintText}"/>
                    </StackPanel>

                    <Button x:Name="SubmitReturnBtn" Grid.Column="4" Content="提交归还焊丝"
                            Style="{StaticResource PrimaryButton}" Width="150" VerticalAlignment="Center"
                            IsEnabled="False" Click="SubmitReturnBtn_Click"/>
                </Grid>
            </Border>

            <Border x:Name="Step5Panel" Grid.Column="2" Style="{StaticResource CardPanel}" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource StepBadge}">
                            <TextBlock Text="6" Style="{StaticResource StepBadgeText}"/>
                        </Border>
                        <TextBlock Text="取出可用焊丝" Style="{StaticResource StepTitleText}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="领用格口：" Style="{StaticResource LabelText}" Width="74"/>
                            <TextBlock x:Name="IssueSlotText" Text="—" Style="{StaticResource ValueText}"/>
                        </StackPanel>
                        <TextBlock Text="发货柜将打开领用格口，请取出可用焊丝并关闭格口门。" Style="{StaticResource HintText}"/>
                    </StackPanel>

                    <Button x:Name="SubmitIssueBtn" Grid.Column="4" Content="提交领用焊丝"
                            Style="{StaticResource PrimaryButton}" Width="150" VerticalAlignment="Center"
                            IsEnabled="False" Click="SubmitIssueBtn_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
