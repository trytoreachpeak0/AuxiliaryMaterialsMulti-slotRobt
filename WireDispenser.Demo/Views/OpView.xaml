<UserControl x:Class="WireDispenser.Demo.Views.OpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <UserControl.Resources>
        <!-- 步骤编号小圆角徽章 -->
        <Style x:Key="StepBadge" TargetType="Border">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style x:Key="StepBadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StepTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Row 0: 操作员身份（横向单行） ============ -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 步骤编号 + 标题 -->
                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StepBadge}">
                        <TextBlock Text="1" Style="{StaticResource StepBadgeText}"/>
                    </Border>
                    <TextBlock Text="操作员身份" Style="{StaticResource StepTitleText}"/>
                </StackPanel>

                <!-- 字段标签行 -->
                <TextBlock Grid.Row="0" Grid.Column="2" Text="操作员ID" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="班组" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="6" Text="班次" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="8" Text="姓名（自动）" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>

                <!-- 字段输入行 -->
                <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource IndustrialTextBox}" Text="E10086"/>
                <ComboBox Grid.Row="1" Grid.Column="4" Style="{StaticResource IndustrialComboBox}">
                    <ComboBoxItem Content="A组" IsSelected="True"/>
                    <ComboBoxItem Content="B组"/>
                    <ComboBoxItem Content="C组"/>
                </ComboBox>
                <ComboBox Grid.Row="1" Grid.Column="6" Style="{StaticResource IndustrialComboBox}">
                    <ComboBoxItem Content="白班" IsSelected="True"/>
                    <ComboBoxItem Content="夜班"/>
                </ComboBox>
                <Border Grid.Row="1" Grid.Column="8" Background="#FFF1F7FF" BorderBrush="#FFB8D6FB" BorderThickness="1"
                        Height="42" Padding="12,0" MinWidth="120">
                    <TextBlock Text="张三" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
                </Border>
                <Button Grid.Row="1" Grid.Column="10" Content="校验" Style="{StaticResource SecondaryButton}" MinWidth="86"/>
            </Grid>
        </Border>

        <!-- ============ Row 2: 焊丝批号 | 机台信息（2列） ============ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 步骤2：焊丝批号 -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Style="{StaticResource StepBadge}">
                            <TextBlock Text="2" Style="{StaticResource StepBadgeText}"/>
                        </Border>
                        <TextBlock Text="焊丝批号" Style="{StaticResource StepTitleText}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="焊丝批号（扫码 / 手动）" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource IndustrialTextBox}" Text="WB-2026-05-28-001"/>
                        <Button Grid.Column="1" Content="查询" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" MinWidth="84"/>
                    </Grid>

                    <Border Grid.Row="3" Background="#FFF1F7FF" BorderBrush="#FFB8D6FB" BorderThickness="1"
                            Padding="12,10" Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="焊丝类型：" Style="{StaticResource LabelText}" Width="92"/>
                                <TextBlock Text="AlSi-25um (铝硅25微米)" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="发货柜匹配：" Style="{StaticResource LabelText}" Width="92"/>
                                <TextBlock Text="2 个（A03, A07）" Style="{StaticResource ValueText}" Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="归还重量：" Style="{StaticResource LabelText}" Width="92"/>
                                <TextBlock Text="0.85 kg / 卷" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 步骤3：机台信息 -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Style="{StaticResource StepBadge}">
                            <TextBlock Text="3" Style="{StaticResource StepBadgeText}"/>
                        </Border>
                        <TextBlock Text="机台信息" Style="{StaticResource StepTitleText}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="机台号" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource IndustrialTextBox}" Text="M-0312"/>
                        <Button Grid.Column="1" Content="校验" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" MinWidth="84"/>
                    </Grid>

                    <Border Grid.Row="3" Background="#FFF1F7FF" BorderBrush="#FFB8D6FB" BorderThickness="1"
                            Padding="12,10" Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="工单批次号：" Style="{StaticResource LabelText}" Width="98"/>
                                <TextBlock Text="LOT-2026-0528-0007" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="发货格口：" Style="{StaticResource LabelText}" Width="98"/>
                                <TextBlock Text="A03（首选）" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="回收格口：" Style="{StaticResource LabelText}" Width="98"/>
                                <TextBlock Text="R05（系统预留）" Style="{StaticResource ValueText}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Row 4: 步骤4 剩余芯片+用量校验 ============ -->
        <Border Grid.Row="4" Style="{StaticResource CardPanel}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1.6*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StepBadge}">
                        <TextBlock Text="4" Style="{StaticResource StepBadgeText}"/>
                    </Border>
                    <TextBlock Text="剩余芯片 / 用量校验" Style="{StaticResource StepTitleText}"/>
                </StackPanel>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="剩余待焊芯片（颗）" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="预计用量（颗）" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="6" Text="实际用量差 (颗)" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>

                <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource IndustrialTextBox}" Text="1280"/>
                <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource IndustrialTextBox}" IsEnabled="False" Text="1320"/>
                <Border Grid.Row="1" Grid.Column="6"
                        Background="#FFEEF8F0" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                        Height="42">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="-40" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" FontSize="18"/>
                        <TextBlock Text="  (≤500 校验通过)" Foreground="{StaticResource SuccessBrush}" FontSize="14" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ Row 6: 提示 + 提交 ============ -->
        <Border Grid.Row="6" Style="{StaticResource CardPanel}" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 提示一行 inline 标签 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Background="#FFEEF8F0" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" Padding="8,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="操作员校验通过：张三 / A组 / 白班" Style="{StaticResource HintText}" Foreground="{StaticResource TextPrimaryBrush}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFEEF8F0" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" Padding="8,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="发货柜匹配 A03 / A07" Style="{StaticResource HintText}" Foreground="{StaticResource TextPrimaryBrush}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFFF7E5" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="用量差值 &gt; 500 颗需重新核对剩余数量" Style="{StaticResource HintText}" Foreground="{StaticResource TextPrimaryBrush}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 提交按钮行 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="提交后，发货柜将自动打开匹配格口，请按提示放入旧焊丝、取出新焊丝。"
                               Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="重置" Style="{StaticResource SecondaryButton}" Width="110" Margin="0,0,10,0"/>
                        <Button Content="提交退 / 取焊丝" Style="{StaticResource PrimaryButton}" Width="180"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
